    "dotenv": "^16.6.1",
    "express": "^5.1.0",
    "framer-motion": "^11.11.1",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.6.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.2"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.2",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.0.1",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.13",
    "vite": "^5.4.8"
  }
}
