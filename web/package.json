{
  "name": "discord-system-dashboard",
  "version": "1.0.0",
  "private": true,
  "description": "Web Dashboard quản lý Discord Bot: Glassmorphism, Framer Motion, TailwindCSS",
  "type": "module",
  "scripts": {
    "dev": "concurrently -n server,client -c blue,magenta \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "node --watch server/index.js",
    "dev:client": "vite",
    "build": "vite build",
    "start": "node server/index.js"
  },
  "dependencies": {
